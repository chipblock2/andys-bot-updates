{
  "version": 1,
  "forms": {
    "event": {
      "title": "Submit an event",
      "destination": "Submissions Queue",
      "defaults": {"submission_type": "Event", "status": "New"},
      "fields": [
        "event_name", "contact_name", "email", "business_venue", "town", "postcode",
        "start_date_time", "end_date_time", "price_or_free", "booking_url", "source_link",
        "age_guidance", "accessibility", "parking_transport", "details", "consent"
      ],
      "review_rule": "Nothing becomes public until reviewed and approved."
    },
    "business_claim": {
      "title": "Claim a business listing",
      "destination": "Business Claims",
      "defaults": {"status": "New"},
      "fields": [
        "business_name", "contact_name", "email", "phone", "town", "postcode", "website",
        "evidence", "requested_changes", "consent"
      ],
      "review_rule": "Ownership or authority must be verified before a listing is marked claimed."
    },
    "alerts": {
      "title": "Ask Shropshire alerts",
      "destination": "Alert Subscriptions",
      "defaults": {"enabled": true},
      "fields": [
        "email", "area", "radius_miles", "categories", "family_friendly", "dog_friendly",
        "accessible", "frequency", "consent"
      ],
      "categories": ["Live music", "Theatre", "Family", "Food", "Walks outdoors", "Markets", "Festivals", "Offers", "Accessibility"],
      "frequencies": ["Instant important changes", "Daily", "Weekly"],
      "privacy_rule": "Store only the email and preferences needed to deliver the requested alerts."
    }
  }
}